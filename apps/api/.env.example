# 服务监听端口
PORT=10002

# OpenAI 兼容的 AI 服务配置
AI_API_URL=https://api.deepseek.com/chat/completions
AI_API_KEY=
AI_MODEL=deepseek-v4-flash

# Web Push VAPID 推送配置（订阅通知功能必需）
# VAPID Subject：邮箱地址，推送服务以此标识推送来源
VAPID_SUBJECT=mailto:admin@example.com
# VAPID 公钥：下发给前端用于订阅时传入
VAPID_PUBLIC_KEY=
# VAPID 私钥：服务端签名推送请求时使用
# 生成命令：npx web-push generate-vapid-keys --json
VAPID_PRIVATE_KEY=

# 注意：
# - CORS 在代码中固定全开放（app.enableCors({ origin: true })），无对应配置项
# - 钉钉凭据与推送订阅仍存放在 data/user-config.json
